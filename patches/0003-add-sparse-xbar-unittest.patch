index 000000000..7301f8c97
--- /dev/null
+++ b/src/main/scala/unittest/SparseXbarTest.scala
@@ -0,0 +1,56 @@
+// riscv_study: sparse-visibility TLXbar study harness.
+// Not upstream rocket-chip code -- tracked locally as patches/0003-add-sparse-xbar-unittest.patch
+// (see docs/01-xbar-sparsity-checklist.md Section H and docs/06-sparse-harness-design.md).
+package freechips.rocketchip.unittest
+
+import chisel3._
+import org.chipsalliance.cde.config.Parameters
+import org.chipsalliance.diplomacy.lazymodule._
+import freechips.rocketchip.diplomacy.AddressSet
+import freechips.rocketchip.tilelink._
+
+/** A TLXbar whose masters have genuinely narrowed diplomacy `visibility`
+  * (not just constrained stimulus), unlike `TLMulticlientXbar` where every
+  * fuzzer keeps the default dense (0, ~0) visibility.
+  *
+  * Each entry in `visibilities` becomes one client, filtered down to that
+  * exact AddressSet via `TLFilter`'s client-side filter (the same mechanism
+  * `TLFilter.cSelectVisibility` style narrowing described in the checklist).
+  * `TLFuzzer.overrideAddress` is set to the same AddressSet so the generated
+  * stimulus never strays outside what the client declared visible --
+  * otherwise `TLMonitor` would (correctly) fire on out-of-visibility
+  * requests and we'd be debugging the testbench, not the DUT.
+  *
+  * 4 fixed managers at AddressSet(0x400*n, 0x3ff), n = 0..3, mirroring the
+  * address layout `TLMulticlientXbar` already uses in this file.
+  */
+class TLSparseXbar(visibilities: Seq[AddressSet], nManagers: Int = 4, txns: Int = 5000)(implicit p: Parameters) extends LazyModule {
+  require(visibilities.nonEmpty)
+
+  val xbar = LazyModule(new TLXbar)
+
+  val fuzzers = visibilities.zipWithIndex.map { case (vis, n) =>
+    val fuzz = LazyModule(new TLFuzzer(txns, overrideAddress = Some(vis)))
+    val filter = LazyModule(new TLFilter(cfilter = { c => Some(c.v1copy(visibility = Seq(vis))) }))
+    xbar.node := TLDelayer(0.1) := filter.node := fuzz.node
+    fuzz
+  }
+
+  (0 until nManagers) foreach { n =>
+    val ram = LazyModule(new TLRAM(AddressSet(0x0 + 0x400 * n, 0x3ff)))
+    ram.node := TLFragmenter(4, 256) := TLDelayer(0.1) := xbar.node
+  }
+
+  lazy val module = new Impl
+  class Impl extends LazyModuleImp(this) with UnitTestModule {
+    // Unlike TLMulticlientXbar (which only waits on fuzzers.last), require
+    // every client to finish -- a stuck/starved client should fail the test.
+    io.finished := fuzzers.map(_.module.io.finished).reduce(_ && _)
+  }
+}
+
+class TLSparseXbarTest(visibilities: Seq[AddressSet], nManagers: Int = 4, txns: Int = 5000, timeout: Int = 500000)(implicit p: Parameters) extends UnitTest(timeout) {
+  val dut = Module(LazyModule(new TLSparseXbar(visibilities, nManagers, txns)).module)
+  dut.io.start := io.start
+  io.finished := dut.io.finished
+}
