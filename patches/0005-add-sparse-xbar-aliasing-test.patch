@@ after WithTLSparseXbarNegativeTest's closing })
+// riscv_study: reproduce the aliasing risk TLMonitor's visibility check
+// CANNOT catch. client0's *declaration* itself is wrong: visibility =
+// manager0's real range UNION an unclaimed region (0x1000-0x13ff) no
+// manager owns. Stimulus is driven entirely inside the unclaimed region,
+// so the round-5 visibility check has nothing to object to.
+class WithTLSparseXbarAliasingTest extends Config((site, here, up) => {
+  case UnitTests => (q: Parameters) => {
+    implicit val p = q
+    val txns = 100 * site(TestDurationMultiplier)
+    val timeout = 50000 * site(TestDurationMultiplier)
+    val clients = Seq(
+      TLSparseXbar.ClientSpec(
+        visibility = Seq(
+          freechips.rocketchip.diplomacy.AddressSet(0x0,    0x3ff),
+          freechips.rocketchip.diplomacy.AddressSet(0x1000, 0x3ff)
+        ),
+        stimulus = freechips.rocketchip.diplomacy.AddressSet(0x1000, 0x3ff)),
+      TLSparseXbar.ClientSpec(freechips.rocketchip.diplomacy.AddressSet(0x0,   0x7ff)),
+      TLSparseXbar.ClientSpec(freechips.rocketchip.diplomacy.AddressSet(0x800, 0x7ff)),
+      TLSparseXbar.ClientSpec(freechips.rocketchip.diplomacy.AddressSet(0x0,   0xfff))
+    )
+    Seq(Module(new TLSparseXbarTest(clients, nManagers=4, txns=2*txns, timeout=timeout)))
+  }
+})

@@ class TLSparseXbarNegativeTestConfig
 class TLSparseXbarNegativeTestConfig extends Config(new WithTLSparseXbarNegativeTest ++ new WithTestDuration(10) ++ new BaseSubsystemConfig)
+class TLSparseXbarAliasingTestConfig extends Config(new WithTLSparseXbarAliasingTest ++ new WithTestDuration(10) ++ new BaseSubsystemConfig)

