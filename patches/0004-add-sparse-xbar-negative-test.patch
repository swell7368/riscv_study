+      TLSparseXbar.ClientSpec(freechips.rocketchip.diplomacy.AddressSet(0x800, 0x7ff)),
+      TLSparseXbar.ClientSpec(freechips.rocketchip.diplomacy.AddressSet(0x0,   0xfff))
+    )
+    Seq(Module(new TLSparseXbarTest(clients, nManagers=4, txns=2*txns, timeout=timeout)))
+  }
+})

