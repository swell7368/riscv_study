@@ package freechips.rocketchip.unittest
+object TLSparseXbar {
+  /** One client's diplomacy visibility (what connectivity gets computed from)
+    * and its stimulus range (what TLFuzzer actually generates). Normally
+    * these are identical. Making them differ is exactly how you build the
+    * checklist's "deliberate negative test": a client whose declared
+    * visibility is narrower than the addresses it actually drives.
+    */
+  case class ClientSpec(visibility: AddressSet, stimulus: AddressSet)
+  object ClientSpec {
+    def apply(both: AddressSet): ClientSpec = ClientSpec(both, both)
+  }
+}
